          "_name": "content17",
          "_sourceTheme": "mobirise5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"content17\" group=\"Content\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background':bg.parallax}\" plugins=\"mbr-switch-arrow, mobirise-icons2\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n        <input type=\"range\" name=\"textWidth\" title=\"Width\" min=\"4\" max=\"12\" value=\"10\" step=\"1\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n        <select title=\"Amount\" name=\"cardAmount\">\n             <option value=\"1\" selected>1</option>\n             <option value=\"2\">2</option>\n             <option value=\"3\">3</option>\n             <option value=\"4\">4</option>\n             <option value=\"5\">5</option>\n             <option value=\"6\">6</option>\n        </select>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background13.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.9\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    \n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        \n            <div class=\"row justify-content-center\">\n                <div class=\"col-12 col-md-{{textWidth}}\">\n                    <div class=\"section-head align-center mb-4\" mbr-if=\"showTitle || showSubtitle\">\n                        <h3 class=\"mbr-section-title mb-0 mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">\n                            <b>Toggle FAQ</b>\n                        </h3>\n                        <h4 class=\"mbr-section-subtitle mt-2 mb-0 mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\">\n                            Subtitle</h4>\n                    </div>\n                    \n                    <div id=\"bootstrap-toggle\" class=\"toggle-panel accordionStyles tab-content\">\n                        <div class=\"card mb-3\">\n                            <div class=\"card-header\" role=\"tab\" id=\"headingOne\">\n                                <a role=\"button\" class=\"collapsed panel-title text-black\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse1\" aria-expanded=\"false\" aria-controls=\"collapse1\">\n                                    <h3 class=\"panel-title-edit mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-title-edit\"><b>List of SLOrk Public Performances</b></h3>\n                                    <span class=\"sign mbr-iconfont mbri-arrow-down\"></span>\n                                </a>\n                            </div>\n                            <div id=\"collapse1\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingOne\">\n                                <div class=\"panel-body\">\n                                    <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\"><b>SLOrktastic Chamber Music 2026</b> (upcoming at time of writing)<br>May 7th, 2026, Thursday 7:30pm | CCRMA Stage<br><b>2026: Saturday Night SLOrk!&nbsp;</b>(upcoming at time of writing)<br>June 6th, 2026, Saturday 7:30pm | Bing Concert Hall, Stanford University<br><br><b>2025</b><br><i>(on parental and sabbatical leave)</i><br><br><b>SLOrktastic Chamber Music 2024&nbsp;</b>(<a href=\"https://slork.stanford.edu/events/notes/2024-slorktastic.pdf\" class=\"text-primary\" target=\"_blank\">program notes</a> | <a href=\"https://slork.stanford.edu/events/2024/slorktastic/\" class=\"text-primary\" target=\"_blank\">website</a>)<br>May 2nd, 2024, Thursday 7:30pm | CCRMA Stage<br><b>2024: SLOrk to the Future!</b> (<a href=\"https://slork.stanford.edu/events/notes/2024-slork-spring.pdf\" class=\"text-primary\" target=\"_blank\">program notes</a> | <a href=\"https://slork.stanford.edu/events/2024/spring/\" class=\"text-primary\" target=\"_blank\">website</a>)<br>June 8th, 2024, Saturday 7:30pm | Bing Concert Hall, Stanford University<br><br><b>The Furies: A Laptopera (World Premiere)&nbsp;</b>(<a href=\"https://slork.stanford.edu/events/2022/laptopera/2022-the-furies.pdf\" class=\"text-primary\" target=\"_blank\">program notes</a> | <a href=\"https://laptopera.org/\" class=\"text-primary\" target=\"_blank\">website</a>)<br>November 11-13, 2022, Friday-Sunday | CCRMA Stage, Stanford University<br><br><b>SLOrktastic Chamber Music 2023&nbsp;</b>(<a href=\"https://slork.stanford.edu/events/notes/2023-slorktastic.pdf\" class=\"text-primary\" target=\"_blank\">program notes</a> | <a href=\"https://slork.stanford.edu/events/2023/slorktastic/\" class=\"text-primary\" target=\"_blank\">website</a>)<br>May 4th, 2023, Thursday 7:30pm | CCRMA Stage<br><b>2023: The SLOrker's Guide to Computer Music&nbsp;</b>(program notes | <a href=\"https://slork.stanford.edu/events/2023/spring/\" class=\"text-primary\" target=\"_blank\">website</a>)<br>June 10th, 2023, Saturday 7:30pm | Bing Concert Hall, Stanford University<br><br><b>SLOrktastic Chamber Music 2022&nbsp;</b>(<a href=\"https://slork.stanford.edu/events/notes/2022-slorktastic.pdf\" class=\"text-primary\" target=\"_blank\">program notes</a> | <a href=\"https://slork.stanford.edu/events/2022/slorktastic/\" class=\"text-primary\" target=\"_blank\">website</a>)<br>May 5th, 2022, Thursday 7:30pm | CCRMA Stage<br><b>2022: The Return of the SLOrk&nbsp;</b>(<a href=\"https://slork.stanford.edu/events/2022/spring/2022-slork-spring.pdf\" class=\"text-primary\" target=\"_blank\">program notes</a> | <a href=\"https://slork.stanford.edu/events/2022/spring/\" class=\"text-primary\" target=\"_blank\">website</a>)<br>June 4th, 2022, Saturday 7:30pm | Bing Concert Hall, Stanford University<br><br><b>2020, 2021</b><br><i>(The 2020 and 2021 Seasons were cancelled due to COVID-19 pandemic)</i><br><br><b>SLOrktastic Chamber Music 2019</b> (<a href=\"https://slork.stanford.edu/events/notes/2019-slorktastic.pdf\" class=\"text-primary\" target=\"_blank\">program notes</a> | <a href=\"https://slork.stanford.edu/events/2019/slorktastic/\" class=\"text-primary\" target=\"_blank\">website</a>)<br>May 2nd, 2019, Thursday 7:30pm | CCRMA Stage<br><b>2019: A SLOrk Odyssey</b> (<a href=\"https://slork.stanford.edu/events/notes/2019-slork-spring.pdf\" class=\"text-primary\" target=\"_blank\">program notes</a> | <a href=\"https://slork.stanford.edu/events/2019/spring/\" class=\"text-primary\" target=\"_blank\">website</a>)<br>June 8th, 2019, Saturday 7:30pm | Bing Concert Hall, Stanford University<br><br><b>SLOrktastic Chamber Music</b> (<a href=\"https://slork.stanford.edu/events/notes/2018-slorktastic.pdf\" class=\"text-primary\">program notes</a> | <a href=\"https://slork.stanford.edu/events/2018/slorktastic/\" class=\"text-primary\" target=\"_blank\">website</a>)<br>May 3rd, 2018, Thursday 7:30pm | CCRMA Stage<br><b>SLOrk @ Bing 2018</b> (<a href=\"https://slork.stanford.edu/events/notes/2018-slork-spring.pdf\" class=\"text-primary\" target=\"_blank\">program notes</a> | <a href=\"https://slork.stanford.edu/events/2018/spring/\" class=\"text-primary\" target=\"_blank\">website</a>)<br>June 9th, 2018, Saturday 7:30pm | Bing Concert Hall, Stanford University<br><br><b>2017<br></b><i>(on sabbatical leave)<br></i><br><b>SLOrktastic Chamber Music</b> (<a href=\"https://slork.stanford.edu/events/notes/2016-slorktastic.pdf\" class=\"text-primary\" target=\"_blank\">program notes</a> | <a href=\"https://slork.stanford.edu/events/2016/slorktastic/\" class=\"text-primary\" target=\"_blank\">website</a>)<br>May 1st, 2016, Sunday 7:30pm | CCRMA Stage<br><b>SLOrk @ Bing 2016</b> (<a href=\"https://slork.stanford.edu/events/notes/2016-slork-spring.pdf\" class=\"text-primary\" target=\"_blank\">program notes</a> | <a href=\"https://slork.stanford.edu/events/2016/spring/\" class=\"text-primary\" target=\"_blank\">website</a>)<br>June 2nd, 2016, Thursday 7:30pm | Bing Concert Hall, Stanford University<br><br><b>SideLObe @ Cantor</b> (<a href=\"https://sidelobe.stanford.edu/events/notes/2015-cantor.pdf\" class=\"text-primary\" target=\"_blank\">program notes</a> | <a href=\"https://sidelobe.stanford.edu/events/2015/cantor/\" class=\"text-primary\" target=\"_blank\">website</a>)<br>February 2nd, 2015, Monday 8:00pm | Cantor Arts Center, Modern and Contemporary Gallery<br><b>SLOrktastic Chamber Music</b> (<a href=\"https://slork.stanford.edu/events/notes/2015-slorktastic.pdf\" class=\"text-primary\" target=\"_blank\">program notes</a> | <a href=\"https://slork.stanford.edu/events/2015/slorktastic/\" class=\"text-primary\" target=\"_blank\">website</a>)<br>April 30th, 2015, Thursday 8:00pm | CCRMA Stage<br><b>SLOrk @ Bing 2015</b> (<a href=\"https://slork.stanford.edu/events/notes/2015-slork-spring.pdf\" class=\"text-primary\" target=\"_blank\">program notes</a> | <a href=\"https://slork.stanford.edu/events/2015/spring/\" class=\"text-primary\" target=\"_blank\">website</a>)<br>May 30th, 2015, Saturday 7:30pm | Bing Concert Hall, Stanford University<br><br><b>SLOrk in China</b> (<a href=\"https://slork.stanford.edu/events/notes/2014-slork-beijing-2.pdf\" class=\"text-primary\" target=\"_blank\">program notes</a> | <a href=\"https://slork.stanford.edu/events/notes/2014-slork-beijing-1.pdf\" class=\"text-primary\" target=\"_blank\">poster</a>&nbsp;| <a href=\"https://www.flickr.com/photos/gewang/albums/72157645523184976/\" class=\"text-primary\" target=\"_blank\">photo album</a> | <a href=\"https://slork.stanford.edu/beijing2014/\" class=\"text-primary\" target=\"_blank\">website</a>)<br>July 3rd, 2014 | Stanford Center @ Peking University<br><b>SLOrktastic Chamber Music 2014</b> (<a href=\"https://slork.stanford.edu/events/notes/2014-slorktastic.pdf\" class=\"text-primary\" target=\"_blank\">program notes</a> | <a href=\"https://slork.stanford.edu/events/2014/slorktastic/\" class=\"text-primary\" target=\"_blank\">website</a>)<br>May 1st, 2014, Thursday 8pm | CCRMA Stage<br><b>SLOrk @ Bing 2014</b> (<a href=\"https://slork.stanford.edu/events/notes/2014-slork-spring.pdf\" class=\"text-primary\" target=\"_blank\">program notes</a> | <a href=\"https://slork.stanford.edu/events/2014/spring/\" class=\"text-primary\" target=\"_blank\">website</a>)<br>May 31st, 2014, Saturday 8pm | Bing Concert Hall, Stanford University<br><br><b>SLOrktastic Chamber Music 2013</b> (<a href=\"https://slork.stanford.edu/events/2013/slorktastic/\" class=\"text-primary\" target=\"_blank\">website</a>)<br>May 2nd, 2013, Thursday 8pm | CCRMA Stage<br><b>SLOrk 2013 Spring Concert</b> (<a href=\"https://slork.stanford.edu/events/notes/2013-slork-spring.pdf\" class=\"text-primary\" target=\"_blank\">program notes</a> | <a href=\"https://slork.stanford.edu/events/2013/spring/\" class=\"text-primary\" target=\"_blank\">website</a>)<br>June 5th, 2013, Wednesday 8pm | Bing Concert Hall, Stanford University<br><br><b>SLOrktastic Chamber Music 2012</b> (<a href=\"https://slork.stanford.edu/events/2012/slorktastic/\" class=\"text-primary\" target=\"_blank\">website</a>)<br>May 3rd, 2012, Thursday 8pm | CCRMA Stage<br><b>SLOrk 2012 Spring Concert</b> (<a href=\"https://slork.stanford.edu/events/notes/2012-slork-spring.pdf\" class=\"text-primary\" target=\"_blank\">program notes</a> | <a href=\"https://slork.stanford.edu/events/2012/spring/\" class=\"text-primary\" target=\"_blank\">website</a>)<br>June 6th, 2012, Wednesday 8pm | Dinkelspiel Auditorium, Stanford University<br><br><b>SLOrktastic Chamber Music 2011</b> (<a href=\"https://slork.stanford.edu/events/notes/2011-slorktastic.pdf\" class=\"text-primary\" target=\"_blank\">program notes</a> | <a href=\"https://slork.stanford.edu/events/2011/slorktastic/\" class=\"text-primary\" target=\"_blank\">website</a>)<br>April 28th, 2011, Thursday 8pm | CCRMA Stage<br><b>SLOrk 2011 Spring Concert</b> (<a href=\"https://slork.stanford.edu/events/notes/2011-slork-spring.pdf\" class=\"text-primary\" target=\"_blank\">program notes</a> | <a href=\"https://slork.stanford.edu/events/2011/spring/\" class=\"text-primary\" target=\"_blank\">website</a>)<br>June 1st, 2011, Wednesday 8pm | Dinkelspiel Auditorium, Stanford University<br><br><b>SLOrktastic Chamber Music 2010 (featuring Jordan Rudess)</b> (<a href=\"https://slork.stanford.edu/events/2010/slorktastic/\" class=\"text-primary\" target=\"_blank\">website</a>)<br>April 29th, 2010, Thursday 8pm | CCRMA Stage<br><b>SLOrk 2010 Spring Concert</b> (<a href=\"https://slork.stanford.edu/events/notes/2010-slork-spring.pdf\" class=\"text-primary\" target=\"_blank\">program notes</a> | <a href=\"https://slork.stanford.edu/events/2010/spring/\" class=\"text-primary\" target=\"_blank\">website</a>)<br>June 2nd, 2010, Wednesday 8pm | Dinkelspiel Auditorium, Stanford University<br><br><b>SLOrk @ MacWorld 2009</b><br>Janaury 9th, 2009, Friday | Moscone Center, San Francisco<br><b>SLOrk =&gt; Southern California</b><br>7pm, March 20th, 2009, Friday | Distinctive Voices @ The Beckman Center<br><b>SLOrktastic Chamber Music I</b> (<a href=\"https://slork.stanford.edu/events/2009/slorktastic/\" class=\"text-primary\" target=\"_blank\">website</a>)<br>May 9th, 2009, Saturday 8pm | CCRMA Stage<br><b>SLOrktastic Chamber Music II</b> (<a href=\"https://slork.stanford.edu/events/2009/slorktastic/\" class=\"text-primary\" target=\"_blank\">website</a>)<br>May 16th, 2009, Saturday 8pm | CCRMA Stage<br><b>SLOrk 2009 Spring Concert</b> (<a href=\"https://slork.stanford.edu/events/2009/spring/\" class=\"text-primary\" target=\"_blank\">website</a>)<br>June 4th, 2009, Thursday 8pm | Dinkelspiel Auditorium, Stanford University<br><br><b>Sonic SLOrk Sculptures</b> (<a href=\"https://slork.stanford.edu/events/2008/sss/\" class=\"text-primary\" target=\"_blank\">website</a>)<br>April 26th, 2008, Saturday 3pm | New Guinea Sculpture Garden, Stanford University<br><b>SLOrktastic Chamber Music</b> (<a href=\"https://slork.stanford.edu/events/notes/2008-slorktastic.pdf\" class=\"text-primary\" target=\"_blank\">program notes</a> | <a href=\"https://slork.stanford.edu/events/2008/chamber/\" class=\"text-primary\" target=\"_blank\">website</a>)<br>May 24th, 2008, Saturday 8pm | CCRMA Stage<br><b>Twilight Concert 2008</b> (<a href=\"https://slork.stanford.edu/events/notes/2008-slork-twilight.pdf\" class=\"text-primary\" target=\"_blank\">program notes</a> | <a href=\"https://slork.stanford.edu/events/2008/twilight/\" class=\"text-primary\" target=\"_blank\">website</a>)<br>June 3rd, 2008, Tuesday 8pm | CCRMA Courtyard, Stanford University<br><b>Pacific Rim of Wire</b> (<a href=\"https://slork.stanford.edu/events/notes/2008-panasian.pdf\" class=\"text-primary\" target=\"_blank\">program notes</a> | <a href=\"https://slork.stanford.edu/events/2008/rim-of-wire/\" class=\"text-primary\" target=\"_blank\">website</a>)<br>April 29th, 2008, Tuesday 8pm | Dinkelspiel Auditorium, Stanford University</p>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"card mb-3\" mbr-if=\"cardAmount > 1\">\n                            <div class=\"card-header\" role=\"tab\" id=\"headingTwo\">\n                                <a role=\"button\" class=\"collapsed panel-title text-black\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse2\" aria-expanded=\"false\" aria-controls=\"collapse2\">\n                                    <h3 class=\"panel-title-edit mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-title-edit\"><br></h3>\n                                    <span class=\"sign mbr-iconfont mbri-arrow-down\"></span>\n                                </a>\n\n                            </div>\n                            <div id=\"collapse2\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingTwo\">\n                                <div class=\"panel-body\">\n                                    <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\">Mobirise Kit is a service that provides the access to all current and new themes/extensions developed by Mobirise. New themes/extensions are released every month and will be available in your account during your plan period, without any additional charge.</p>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"card mb-3\" mbr-if=\"cardAmount > 2\">\n                            <div class=\"card-header\" role=\"tab\" id=\"headingThree\">\n                                <a role=\"button\" class=\"collapsed panel-title text-black\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse3\" aria-expanded=\"false\" aria-controls=\"collapse3\">\n                                    <h3 class=\"panel-title-edit mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-title-edit\"><b>Can I create sites for commerical projects?</b>\n                                </h3>\n                                    <span class=\"sign mbr-iconfont mbri-arrow-down\"></span>\n                                </a>\n                            </div>\n                            <div id=\"collapse3\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingThree\">\n                                <div class=\"panel-body\">\n                                    <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\">Yes, Mobirise is free for both non-profit and commercial sites.</p>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"card mb-3\" mbr-if=\"cardAmount > 3\">\n                            <div class=\"card-header\" role=\"tab\" id=\"headingThree\">\n                                <a role=\"button\" class=\"collapsed panel-title text-black\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse4\" aria-expanded=\"false\" aria-controls=\"collapse4\">\n                                    <h3 class=\"panel-title-edit mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-title-edit\"><b>What is Code Editor?</b>\n                                </h3>\n                                    <span class=\"sign mbr-iconfont mbri-arrow-down\"></span>\n                                </a>\n                            </div>\n                            <div id=\"collapse4\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingThree\">\n                                <div class=\"panel-body\">\n                                    <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\">\n                                       This extension allows editing the code of block in the app. Also, it's possible to add code to the head and body parts of pages.</p>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"card mb-3\" mbr-if=\"cardAmount > 4\">\n                            <div class=\"card-header\" role=\"tab\" id=\"headingThree\">\n                                <a role=\"button\" class=\"collapsed panel-title text-black\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse5\" aria-expanded=\"false\" aria-controls=\"collapse5\">\n                                   <h3 class=\"panel-title-edit mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-title-edit\"><b>What is Mobirise Kit?</b></h3>\n                                        <span class=\"mbr-iconfont mobi-mbri-arrow-down mobi-mbri\"></span>\n                                </a>\n                            </div>\n                            <div id=\"collapse5\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingThree\">\n                                <div class=\"panel-body\">\n                                    <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\">\n                                       Mobirise Kit is a service that provides the access to all current and new themes/extensions developed by Mobirise. New themes/extensions are released every month and will be available in your account during your plan period, without any additional charge.</p>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"card mb-3\" mbr-if=\"cardAmount > 5\">\n                            <div class=\"card-header\" role=\"tab\" id=\"headingThree\">\n                                <a role=\"button\" class=\"collapsed panel-title text-black\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse6\" aria-expanded=\"false\" aria-controls=\"collapse6\">\n                                    <h3 class=\"panel-title-edit mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-title-edit\"><b>Can I create sites for commerical projects?</b></h3>\n                                    <span class=\"mbr-iconfont mobi-mbri-arrow-down mobi-mbri\"></span>\n                                </a>\n                            </div>\n                            <div id=\"collapse6\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingThree\">\n                                <div class=\"panel-body\">\n                                    <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\">\n                                       Yes, Mobirise is free for both non-profit and commercial sites.</p>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n</section>",
          "_cid": "vgwCA0owcv",
          "_anchor": "content17-3n",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "background-color": "@bgColor",
            ".mbr-section-subtitle": {
              "text-align": "center"
            }
          },
          "_name": "content5",
          "_sourceTheme": "mobirise5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"content5\" group=\"Content\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n        <input type=\"range\" name=\"textWidth\" title=\"Width\" min=\"4\" max=\"12\" value=\"10\" step=\"1\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n        <header>Background</header>\n        <input type=\"color\" title=\"Color\" name=\"bgColor\" value=\"#ffffff\">\n    </mbr-parameters>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-md-12 col-lg-{{textWidth}}\">\n                <h3 class=\"mbr-section-title mbr-fonts-style mb-4\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\">\n                    <b>Article Title</b>\n                </h3>\n                <h4 class=\"mbr-section-subtitle mbr-fonts-style mb-4\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-5\">\n                    Images of SLOrk Past and Present</h4>\n                <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">\n                    Over nearly two decades, the Stanford Laptop Orchestra has produced an expansive portfolio of musical works, new instruments, and performances. Each of these serve simultaneously as acts of engineering, artistic expression, and critical practice research into what it means to make computer music together as an ensemble and a community of musician tool-builders. We end this entry in the Portfolio with a few selected images of SLOrk from over the years.</p>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "vgwwHWcZyo",
          "_anchor": "content5-3m",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "@media (max-width: 991px)": {
              ".image-wrapper": {
                "margin-bottom": "1rem"
              }
            },
            ".row": {
              "flex-direction": "row-reverse"
            },
            "img": {
              "width": "100%"
            }
          },
          "_name": "image3",
          "_sourceTheme": "mobirise5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"image3\" group=\"Images & Videos\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-fullscreen': fullScreen,\n                    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <input type=\"range\" name=\"textWidth\" title=\"Image\" min=\"4\" max=\"12\" step=\"1\" value=\"10\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background13.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-lg-{{textWidth}}\">\n                <div class=\"image-wrapper\">\n                    <img src=\"@PROJECT_PATH@/assets/images/2014-slork-china-2136x1053.jpg\" alt=\"SLOrk in China 2014\">\n                    <p class=\"mbr-description mbr-fonts-style mt-2 align-center\" mbr-theme-style=\"image-caption\" mbr-if=\"showText\" data-app-selector=\".mbr-description\">2014:&nbsp;<b>SLOrk in Beijing. A three week summer residency at the Stanford Center in Peking University, SLOrk presents a concert of new works.</b></p>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
